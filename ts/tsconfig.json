{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Standalone on purpose: this directory is published as its own repository,
  // so nothing here may extend a file outside it. The options are the strictest
  // set the engine is written against; `tsconfig.build.json` emits `dist/`.
  "include": ["src", "test", "scripts", "examples"],
  "compilerOptions": {
    "types": ["node"],
    "target": "es2023",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedDeclarations": false,
    "noErrorTruncation": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true,
    "rootDir": ".",
    "outDir": ".tsbuildinfo/out",
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.tsbuildinfo"
  }
}
