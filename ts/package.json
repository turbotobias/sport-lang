{
  "name": "pace-geojson",
  "version": "0.1.0",
  "description": "The rules of an endurance event, as one file any software can run: a GeoJSON course carrying the rules, and a pure fold from timing observations to every entrant's result.",
  "keywords": [
    "endurance",
    "geojson",
    "race",
    "results",
    "rules",
    "sport",
    "timing"
  ],
  "homepage": "https://github.com/turbotobias/pace-geojson#readme",
  "bugs": "https://github.com/turbotobias/pace-geojson/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbotobias/pace-geojson.git",
    "directory": "ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./packs/*": "./src/packs/*.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./packs/*": {
        "types": "./dist/packs/*.d.ts",
        "default": "./dist/packs/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node scripts/pack.mjs clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit && vitest run",
    "prepack": "node scripts/pack.mjs clean && tsc -p tsconfig.build.json && node scripts/pack.mjs pack",
    "postpack": "node scripts/pack.mjs unpack"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.4",
    "@types/node": "26.6.5",
    "effect": "4.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  }
}
